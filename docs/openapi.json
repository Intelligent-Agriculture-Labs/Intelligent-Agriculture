       "minimum": -60,
       "title": "Lat"
      }
     },
     {
      "name": "lon",
      "in": "query",
      "required": true,
      "schema": {
       "type": "number",
       "maximum": 180,
       "minimum": -180,
       "title": "Lon"
      }
     },
     {
      "name": "as_of",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
