 "components": {
  "schemas": {
   "FieldInput": {
    "properties": {
     "lat": {
      "type": "number",
      "maximum": 75.0,
      "minimum": -60.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     },
     "crop": {
      "type": "string",
      "title": "Crop"
     },
     "planting_date": {
      "type": "string",
      "title": "Planting Date"
     },
     "irrigation": {
      "type": "string",
      "enum": [
       "none",
       "drip",
       "sprinkler",
       "pivot",
       "furrow",
       "flood"
      ],
      "title": "Irrigation",
      "default": "sprinkler"
     },
     "polygon": {
      "anyOf": [
       {
        "items": {
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Polygon"
     },
     "water_allocation_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Water Allocation Mm"
     },
     "last_irrigation_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Irrigation Date"
     },
     "last_irrigation_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Last Irrigation Mm"
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "es",
       "fr",
       "sw",
       "hi",
       "de"
      ],
      "title": "Lang",
      "default": "en"
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     }
    },
    "type": "object",
    "required": [
     "lat",
     "lon",
     "crop",
     "planting_date"
    ],
    "title": "FieldInput"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Priorities": {
    "properties": {
     "water": {
      "type": "number",
      "title": "Water",
      "default": 0.3
     },
     "soil": {
      "type": "number",
      "title": "Soil",
      "default": 0.2
     },
     "income": {
      "type": "number",
      "title": "Income",
      "default": 0.25
     },
     "pests": {
      "type": "number",
      "title": "Pests",
      "default": 0.1
     },
     "risk": {
      "type": "number",
      "title": "Risk",
      "default": 0.15
     }
    },
    "type": "object",
    "title": "Priorities"
   },
   "RotationRequest": {
    "properties": {
     "lat": {
      "type": "number",
      "maximum": 75.0,
      "minimum": -60.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     },
     "current_rotation": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 6,
      "minItems": 1,
      "title": "Current Rotation"
     },
     "irrigation": {
      "type": "string",
      "enum": [
       "none",
       "drip",
       "sprinkler",
       "pivot",
       "furrow",
       "flood"
      ],
      "title": "Irrigation",
      "default": "sprinkler"
     },
     "water_allocation_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Water Allocation Mm"
     },
     "priorities": {
      "$ref": "#/components/schemas/Priorities",
      "default": {
       "water": 0.3,
       "soil": 0.2,
       "income": 0.25,
       "pests": 0.1,
       "risk": 0.15
      }
     },
     "lang": {
      "type": "string",
      "enum": [
       "en",
       "es",
       "fr",
       "sw",
       "hi",
       "de"
      ],
      "title": "Lang",
      "default": "en"
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     }
    },
    "type": "object",
    "required": [
     "lat",
     "lon",
     "current_rotation"
    ],
    "title": "RotationRequest"
   },
   "SimulateRequest": {
    "properties": {
     "lat": {
      "type": "number",
      "maximum": 75.0,
      "minimum": -60.0,
      "title": "Lat"
     },
     "lon": {
      "type": "number",
      "maximum": 180.0,
      "minimum": -180.0,
      "title": "Lon"
     },
     "crop": {
      "type": "string",
      "title": "Crop"
     },
     "planting_date": {
      "type": "string",
      "title": "Planting Date"
     },
     "irrigation_strategy": {
      "type": "string",
      "enum": [
       "rainfed",
       "full",
       "deficit_75",
       "deficit_50",
       "allocation"
      ],
      "title": "Irrigation Strategy",
      "default": "full"
     },
     "irrigation_method": {
      "type": "string",
      "enum": [
       "none",
       "drip",
       "sprinkler",
       "pivot",
       "furrow",
       "flood"
      ],
      "title": "Irrigation Method",
      "default": "sprinkler"
     },
     "water_allocation_mm": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Water Allocation Mm"
     },
     "delta_t_c": {
      "type": "number",
      "maximum": 6.0,
      "minimum": -2.0,
      "title": "Delta T C",
      "default": 0.0
     },
     "rain_factor": {
      "type": "number",
      "maximum": 1.7,
      "minimum": 0.3,
      "title": "Rain Factor",
      "default": 1.0
     },
     "years": {
      "type": "integer",
      "maximum": 35.0,
      "minimum": 5.0,
      "title": "Years",
      "default": 20
     },
     "as_of": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "As Of"
     }
    },
    "type": "object",
    "required": [
     "lat",
     "lon",
     "crop",
     "planting_date"
    ],
    "title": "SimulateRequest"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
}