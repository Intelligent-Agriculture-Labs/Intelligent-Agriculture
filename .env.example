# Copy to .env — never commit real values.
# Optional: NASA Earthdata Login bearer token (not required; FieldShift uses no-auth NASA endpoints by default)
EARTHDATA_TOKEN=
# Backend
FIELDSHIFT_CACHE_DIR=backend/.cache
FIELDSHIFT_OFFLINE=0            # 1 = never call the network; serve pre-cached demo data only
FIELDSHIFT_LLM_EXPLAIN=0        # optional LLM phrasing layer (feature-flagged, off by default)
ANTHROPIC_API_KEY=
# Client
EXPO_PUBLIC_API_URL=http://localhost:8000
