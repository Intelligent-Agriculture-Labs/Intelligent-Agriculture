{
  "expo": {
    "name": "IA",
    "slug": "fieldshift",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.fieldshift.app",
      "infoPlist": {
        "CFBundleDisplayName": "IA",
        "NSLocationWhenInUseUsageDescription": "IA uses your location to find NASA data for your field.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07110b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.fieldshift.app",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "IA · Intelligent Agriculture",
      "shortName": "IA",
      "themeColor": "#2f6b3a"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "IA uses your location to find NASA data for your field."
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f6f8f3",
          "dark": {
            "backgroundColor": "#0f1611"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "fieldshift",
    "description": "IA · Intelligent Agriculture. Better decisions. Better harvests. NASA Earth observations turned into weekly farm decisions and crop-rotation strategies.",
    "experiments": {
      "typedRoutes": false
    }
  }
}
