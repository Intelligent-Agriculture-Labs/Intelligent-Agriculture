# Rendered by the nginx image's envsubst step; NGINX_LOCAL_RESOLVERS is filled from /etc/resolv.conf,
# so the API host is resolved at request time (works with Docker's and podman's DNS, and survives restarts).
server {
  listen 80;
  root /usr/share/nginx/html;
  gzip on;
  gzip_types text/plain text/css application/json application/javascript image/svg+xml;
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
  set $api_upstream http://api:8000;

  location /api/ {
    proxy_pass $api_upstream;
    proxy_read_timeout 300s;
    proxy_set_header Host $host;
  }
  location = /docs { proxy_pass $api_upstream; }
  location = /openapi.json { proxy_pass $api_upstream; }
  location / {
    try_files $uri $uri.html $uri/ /index.html;
  }
}
